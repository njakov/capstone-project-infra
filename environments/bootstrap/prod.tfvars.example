# Copy to prod.tfvars (or edit the committed live file) when retargeting GCP project.
# Required keys for bootstrap apply.

project_id = "YOUR_GCP_PROJECT_ID"
region     = "europe-west1"
env        = "prod"
app_name   = "petclinic"

# App plane CIDRs (must not overlap dev within the same GCP project)
subnet_cidr   = "10.11.0.0/24"
pods_cidr     = "10.21.0.0/16"
services_cidr = "10.31.0.0/16"

# Infra plane (GCE runners)
infra_subnet_cidr = "10.51.0.0/24"
