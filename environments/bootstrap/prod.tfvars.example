# Copy to prod.tfvars (or edit the committed live file) when retargeting GCP project.
# Required keys for bootstrap apply.

project_id = "petclinic-gke-prod"
region     = "europe-west1"
env        = "prod"
app_name   = "petclinic"

# Infra plane (GCE runners)
infra_subnet_cidr = "10.51.0.0/24"
